{
  "name": "andrascrapy",
  "version": "1.0.0",
  "description": "AndraScrapy - scraper e dashboard de BI para ncrangola.com",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-handlebars": "^8.0.3",
    "handlebars": "^4.7.10",
    "puppeteer": "^25.16.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  },
  "scripts": {
    "sync": "node src/cli/sync.js",
    "dashboard": "node src/web/server.js",
    "css": "tailwindcss -c tailwind.config.cjs -i public/css/input.css -o public/css/app.css --minify",
    "build": "npm run css",
    "test": "node --test test/*.test.js",
    "cron:install": "node src/cli/cron.js install",
    "cron:remove": "node src/cli/cron.js remove",
    "cron:status": "node src/cli/cron.js status"
  },
  "engines": {
    "node": ">=21"
  }
}
