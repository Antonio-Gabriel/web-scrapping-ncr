{{#> header heading="Categorias" sub=""}}{{/header}}
<p class="-mt-3 text-sm text-ink-soft">{{num withProducts}} de {{num total}} categorias têm produtos. As restantes estão vazias no site e ficam ocultas.</p>
<div class="card overflow-hidden">
  <div class="grid grid-cols-[1fr_70px] gap-3 border-b border-line px-4 py-2.5 pl-10 text-xs font-medium text-ink-mute sm:grid-cols-[1fr_90px_130px_90px_90px]">
    <span>Categoria</span><span class="num">Produtos</span><span class="num hidden sm:block">Preço médio</span><span class="num hidden sm:block">Promoções</span><span class="num hidden sm:block">Stock baixo</span>
  </div>
  {{#each roots}}
  <details class="group border-b border-line last:border-b-0" {{#if @first}}open{{/if}}>
    <summary class="flex items-center bg-canvas/50 pl-3"><span class="text-ink-mute transition-transform group-open:rotate-90">{{icon "chevron"}}</span><div class="min-w-0 flex-1">{{> cat-row}}</div></summary>
    {{#each children}}
      {{#if children}}
      <details class="group/sub border-t border-line/70">
        <summary class="flex items-center pl-7"><span class="text-ink-mute transition-transform group-open/sub:rotate-90">{{icon "chevron"}}</span><div class="min-w-0 flex-1">{{> cat-row}}</div></summary>
        {{#each children}}<div class="border-t border-line/70 pl-14 text-ink-soft">{{> cat-row}}</div>{{/each}}
      </details>
      {{else}}<div class="border-t border-line/70 pl-11">{{> cat-row}}</div>{{/if}}
    {{/each}}
  </details>
  {{/each}}
</div>
