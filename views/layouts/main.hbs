<!doctype html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · AndraScrapy</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/app.js" defer></script>
</head>
<body>
<div class="flex min-h-screen">
  <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 hidden w-60 flex-col border-r border-line bg-surface lg:sticky lg:top-0 lg:flex lg:h-screen">
    <a href="/" class="flex items-center gap-2.5 px-5 pb-4 pt-5">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand-500 text-white">{{icon "activity" "h-4 w-4"}}</span>
      <span><span class="block text-[15px] font-semibold leading-4">AndraScrapy</span><span class="block text-[11px] text-ink-mute">NCR Angola · Que Rápido</span></span>
    </a>
    <nav class="flex-1 space-y-5 overflow-y-auto px-3 py-2">
      {{#each nav}}
      <div>
        <p class="mb-1 px-3 text-[11px] font-medium text-ink-mute">{{group}}</p>
        <div class="space-y-0.5">
          {{#each items}}<a href="{{href}}" class="nav-item {{#if active}}active{{/if}}" {{#if active}}aria-current="page"{{/if}}>{{icon icon}}{{label}}</a>{{/each}}
        </div>
      </div>
      {{/each}}
    </nav>
    <div class="m-3 rounded-xl border border-line bg-canvas p-3">
      <p class="text-xs font-semibold">Sincronização</p>
      {{#each syncs}}
      <div class="mt-2 {{#unless @first}}border-t border-line pt-2{{/unless}}">
        <div class="flex items-center justify-between gap-2">
          <p class="text-xs font-medium">{{name}}</p>
          {{#if failed}}<span class="chip tone-critical">Falhou</span>{{else if never}}<span class="chip tone-neutral">Sem dados</span>{{else if stale}}<span class="chip tone-serious">Atrasada</span>{{else}}<span class="chip tone-good">Em dia</span>{{/if}}
        </div>
        <p class="mt-0.5 text-xs text-ink-mute">Última: {{ago run.finished_at}} · próxima às {{next}}</p>
      </div>
      {{/each}}
    </div>
  </aside>
  <div id="backdrop" class="fixed inset-0 z-30 hidden bg-black/30 lg:hidden"></div>

  <div class="min-w-0 flex-1">
    <header class="sticky top-0 z-20 flex items-center gap-3 border-b border-line bg-surface/95 px-4 py-2.5 backdrop-blur sm:px-6">
      <button id="menu-btn" class="btn lg:hidden" aria-label="Abrir menu">{{icon "menu"}}</button>
      <form action="/produtos" class="relative max-w-md flex-1" role="search">{{#if fonteKey}}<input type="hidden" name="fonte" value="{{fonteKey}}">{{/if}}
        <span class="pointer-events-none absolute left-3 top-2 text-ink-mute">{{icon "search"}}</span>
        <input id="global-search" name="q" value="{{searchValue}}" type="search" aria-label="Pesquisar produtos" placeholder="Pesquisar produto, marca ou referência…" class="field w-full rounded-full bg-canvas pl-9">
      </form>
      <a href="{{headerSite.url}}" target="_blank" rel="noopener noreferrer" class="btn ml-auto hidden sm:inline-flex">{{headerSite.label}} {{icon "external" "h-3.5 w-3.5"}}</a>
    </header>
    <main class="mx-auto max-w-[1400px] space-y-5 p-4 sm:p-6">{{{body}}}</main>
  </div>
</div>
<div id="tooltip" role="status"></div>
</body>
</html>
