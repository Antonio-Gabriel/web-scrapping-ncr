{{#> header heading="Lojas" sub="Lojas físicas e pontos de levantamento publicados no site."}}{{/header}}
{{#unless src.hasStores}}
<div class="card px-5 py-12 text-center">
  <p class="font-medium">Sem lojas recolhidas para {{src.name}}</p>
  <p class="mx-auto mt-1 max-w-md text-xs text-ink-mute">O AndraScrapy só recolhe lojas quando o site as publica num formato que dá para ler. Na Que Rápido, recolhem-se os produtos, as categorias, os preços e o estado do stock.</p>
</div>
{{else}}
<section class="grid grid-cols-2 gap-3 lg:grid-cols-3">
  {{> kpi label="Lojas físicas" value=(num physical.length)}}
  {{> kpi label="Pontos de levantamento" value=(num pickup.length)}}
  {{> kpi label="Cidades" value=(num cities)}}
</section>
<section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
  {{#each physical}}{{> store-card}}{{/each}}
</section>
{{#if pickup}}<h2 class="pt-2 text-base font-semibold">Pontos de levantamento</h2><section class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">{{#each pickup}}{{> store-card}}{{/each}}</section>{{/if}}
<p class="text-xs text-ink-mute">O site não associa stock a cada loja, por isso as quantidades deste dashboard são do total online.</p>
{{/unless}}
