<nav class="mt-3 flex flex-wrap gap-1 rounded-xl border border-line bg-surface p-1 shadow-card" aria-label="Fonte dos dados">
  {{#each @root.sourceTabs}}<a href="{{href}}" class="rounded-lg px-3.5 py-1.5 text-[13px] font-medium {{#if active}}bg-brand-500 text-white{{else}}text-ink-soft hover:bg-canvas hover:text-ink{{/if}}" {{#if active}}aria-current="page"{{/if}}>{{name}}{{#if count}} <span class="tabular-nums {{#if active}}opacity-80{{else}}opacity-60{{/if}}">{{num count}}</span>{{/if}}</a>{{/each}}
</nav>
