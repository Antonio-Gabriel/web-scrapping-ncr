<div class="flex h-52 items-stretch gap-2" role="img" aria-label="{{aria}}">
  {{#each rows}}
  <div class="flex min-w-0 flex-1 flex-col" data-tip="{{label}}: {{display}} produtos">
    <div class="flex flex-1 flex-col items-center justify-end border-b border-line-strong">
      <span class="mb-1 text-xs font-medium tabular-nums">{{display}}</span>
      <span class="column block" style="height:{{height}}%"></span>
    </div>
    <span class="mt-1.5 text-center text-[11px] leading-3 text-ink-mute">{{label}}</span>
  </div>
  {{/each}}
</div>
