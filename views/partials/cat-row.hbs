<div class="grid grid-cols-[1fr_70px] items-center gap-3 px-4 py-2.5 sm:grid-cols-[1fr_90px_130px_90px_90px]">
  <a href="/produtos?category={{id}}" class="min-w-0 truncate font-medium hover:text-brand-600">{{name}}</a>
  <span class="num">{{num products}}</span>
  <span class="num hidden text-ink-soft sm:block">{{kzShort avg_price}}</span>
  <span class="num hidden text-ink-soft sm:block">{{num promos}}</span>
  <span class="num hidden text-ink-soft sm:block">{{num low}}</span>
</div>
