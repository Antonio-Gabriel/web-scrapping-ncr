<div class="flex h-6 gap-0.5" role="img" aria-label="Distribuição de produtos por nível de stock">
  {{#each levels}}<a href="{{href}}" class="block h-full first:rounded-l last:rounded-r" style="width:{{share}}%;background:{{color}}" data-tip="{{label}}: {{display}}"></a>{{/each}}
</div>
<ul class="mt-3 space-y-1.5">
  {{#each levels}}
  <li class="flex items-center justify-between gap-2 text-[13px]">
    <span class="flex items-center gap-2 text-ink-soft"><span class="h-2.5 w-2.5 rounded-sm" style="background:{{color}}"></span>{{label}}</span>
    <span class="font-medium tabular-nums">{{display}}</span>
  </li>
  {{/each}}
</ul>
