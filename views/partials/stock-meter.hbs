{{#if availability}}<span class="text-xs text-ink-soft">{{availabilityText availability}}</span>{{else}}<div class="w-24">
  <div class="h-1.5 overflow-hidden rounded-full bg-canvas"><div class="h-full rounded-full fill-{{stockTone this}}" style="width:{{stockPct available_qty}}%"></div></div>
  <p class="mt-1 text-xs tabular-nums text-ink-soft">{{stockLabel available_qty}} un.</p>
</div>{{/if}}
