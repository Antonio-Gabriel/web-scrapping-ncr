<a href="{{productHref source id}}" class="flex min-w-[240px] items-center gap-3">
  <span class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-lg border border-line bg-white">
    {{#if image_url}}<img src="{{thumb image_url 80}}" alt="" loading="lazy" referrerpolicy="no-referrer" class="h-full w-full object-contain">{{/if}}
  </span>
  <span class="min-w-0">
    <span class="line-clamp-1 font-medium hover:text-brand-600">{{or name product_name}}</span>
    <span class="block truncate text-xs text-ink-mute">{{#if brand}}{{brand}}{{/if}}{{#if reference}} · {{reference}}{{/if}}</span>
  </span>
</a>
