{{#if rows}}
<div class="overflow-x-auto">
<table class="data-table">
  <thead><tr><th>Alteração</th><th>Produto</th><th>Detalhe</th><th>Quando</th></tr></thead>
  <tbody>
  {{#each rows}}
  <tr>
    <td><span class="chip tone-{{eventTone type}}">{{eventLabel type}}</span></td>
    <td><a class="line-clamp-1 min-w-[200px] font-medium hover:text-brand-600" href="/produtos/{{product_id}}">{{product_name}}</a></td>
    <td class="whitespace-nowrap text-ink-soft tabular-nums">{{eventDetail this}}</td>
    <td class="whitespace-nowrap text-xs text-ink-mute" title="{{date at}}">{{ago at}}</td>
  </tr>
  {{/each}}
  </tbody>
</table>
</div>
{{else}}
<div class="px-4 py-10 text-center">
  <p class="font-medium">{{empty}}</p>
  <p class="mx-auto mt-1 max-w-md text-xs text-ink-mute">A primeira recolha serve de base. As alterações aparecem aqui quando uma sincronização horária encontrar diferenças.</p>
</div>
{{/if}}
