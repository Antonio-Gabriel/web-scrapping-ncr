<nav class="text-xs text-ink-mute"><a class="hover:text-ink" href="/produtos{{@root.fq}}">Produtos</a> › {{product.category_path}}</nav>
<section class="card grid gap-6 p-5 md:grid-cols-[220px_1fr]">
  <div class="grid h-56 place-items-center overflow-hidden rounded-xl border border-line bg-white">
    {{#if product.image_url}}<img src="{{thumb product.image_url 440}}" alt="{{product.name}}" referrerpolicy="no-referrer" class="h-full w-full object-contain">{{/if}}
  </div>
  <div class="min-w-0">
    <p class="text-xs font-medium text-ink-mute">{{product.brand}}{{#if product.reference}} · Ref. {{product.reference}}{{/if}}</p>
    <h1 class="mt-1 text-xl font-semibold tracking-tight">{{product.name}}</h1>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <span class="chip tone-{{stockTone product}}">{{stockText product}}</span>
      {{#if product.on_promo}}<span class="chip tone-promo">-{{pct product.discount_pct}}</span>{{/if}}
      {{#each clusters}}<span class="chip tone-neutral">{{this}}</span>{{/each}}
    </div>
    <div class="mt-4 flex flex-wrap items-end gap-x-8 gap-y-3">
      <div><p class="text-xs text-ink-mute">Preço</p><p class="text-2xl font-semibold tabular-nums">{{kz product.price}}</p>{{#if product.on_promo}}<p class="text-xs text-ink-mute line-through tabular-nums">{{kz product.list_price}}</p>{{/if}}</div>
      <div><p class="text-xs text-ink-mute">Stock</p><p class="text-2xl font-semibold tabular-nums">{{stockLabel product.available_qty}}</p></div>
      <div><p class="text-xs text-ink-mute">Visto pela primeira vez</p><p class="font-medium">{{date product.first_seen}}</p></div>
    </div>
    <a class="btn mt-4" href="{{safeUrl product.url}}" target="_blank" rel="noopener noreferrer">Abrir na loja {{icon "external" "h-3.5 w-3.5"}}</a>
    {{#if product.description}}<p class="mt-4 max-w-3xl text-ink-soft">{{product.description}}</p>{{/if}}
  </div>
</section>
<section class="grid gap-5 lg:grid-cols-2">
  <div class="card p-5"><h2 class="card-title">Histórico de preço</h2><p class="card-sub mb-3">Regista-se um ponto sempre que o preço muda.</p>
    {{#if (gt priceSeries.length 1)}}<div data-line-chart data-format="kz" data-title="Preço" data-points="{{json priceSeries}}"></div>{{else}}<p class="py-8 text-center text-xs text-ink-mute">Preço sem alterações desde que é acompanhado.</p>{{/if}}</div>
  <div class="card p-5"><h2 class="card-title">Histórico de stock</h2><p class="card-sub mb-3">Unidades confirmadas; 50 significa 50 ou mais.</p>
    {{#if (gt stockSeries.length 1)}}<div data-line-chart data-format="num" data-title="Stock" data-points="{{json stockSeries}}"></div>{{else}}<p class="py-8 text-center text-xs text-ink-mute">Stock sem alterações desde que é acompanhado.</p>{{/if}}</div>
</section>
{{#if specs}}<section class="card p-5"><h2 class="card-title mb-3">Especificações</h2><dl class="grid gap-x-8 gap-y-2 md:grid-cols-2">{{#each specs}}<div class="flex justify-between gap-4 border-b border-line/70 pb-2"><dt class="text-ink-mute">{{k}}</dt><dd class="text-right">{{v}}</dd></div>{{/each}}</dl></section>{{/if}}
{{#if events}}<section class="card overflow-hidden"><h2 class="card-title p-5 pb-3">Alterações</h2><div class="overflow-x-auto"><table class="data-table"><tbody>{{#each events}}<tr><td><span class="chip tone-{{eventTone type}}">{{eventLabel type}}</span></td><td class="tabular-nums text-ink-soft">{{eventDetail this}}</td><td class="text-xs text-ink-mute">{{date at}}</td></tr>{{/each}}</tbody></table></div></section>{{/if}}
